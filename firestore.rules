// Firebase 콘솔 → Firestore Database → 규칙 에 그대로 붙여넣는다.
// profiles 는 로그인한 누구나 읽고(친구 찾기) 본인만 쓴다(admin 값은 콘솔에서만 바꿀 수 있다).
// saves(진행)·friends(친구 목록)는 본인만. requests(친구 요청)는 보낸 사람이 만들고, 받은 사람이 수락/거절한다.
// 수락하면 받은 사람이 보낸 사람의 friends 에도 자기를 넣는데, 그 요청 문서가 남아 있을 때만 허용한다.
// feedback(개발자에게 요청)은 로그인한 사람이 만들고, 본인과 관리자(profiles.admin == true)만 읽으며, 답장은 관리자만 쓴다.
// leaderboard(주간 순위)는 누구나(로그인 전에도) 읽고, 로그인한 사람이 entries 안의 자기 uid 항목만 쓴다.
// duels(친구 대결)는 players 에 든 두 사람만 읽고 고치며, 신청한 사람이 만든다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    function adminUnchanged() {
      return !('admin' in request.resource.data) || (resource != null && 'admin' in resource.data && request.resource.data.admin == resource.data.admin);
    }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if mine(uid) && request.resource.data.name is string && request.resource.data.name.size() <= 8 && adminUnchanged();
      allow delete: if mine(uid);
    }
    match /saves/{uid} {
      // 읽기·삭제에는 request.resource 가 없어서 한 줄에 같이 쓰면 읽기가 막힌다 (그래서 클라우드 저장을 못 읽고 새 게임이 시작됐다)
      allow read, delete: if mine(uid);
      allow create, update: if mine(uid) && (!("data" in request.resource.data) || request.resource.data.data.size() < 900000);
    }
    match /friends/{uid}/list/{friendUid} {
      allow read, delete: if mine(uid);
      allow create, update: if mine(uid)
        || (signedIn() && request.auth.uid == friendUid && exists(/databases/$(database)/documents/requests/$(friendUid)/list/$(uid)));
    }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('admin', false) == true; }
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (!('data' in request.resource.data) || request.resource.data.data == null || request.resource.data.data.size() < 900000);
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    function validEntry(e) { return e.n is string && e.n.size() <= 8 && e.s is number && e.q is number && e.c is number && e.b is number; }
    match /leaderboard/{week} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['entries'])
        && request.resource.data.entries.keys().hasOnly([request.auth.uid]) && validEntry(request.resource.data.entries[request.auth.uid]);
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entries'])
        && request.resource.data.entries.diff(resource.data.entries).affectedKeys().hasOnly([request.auth.uid]) && validEntry(request.resource.data.entries[request.auth.uid]);
    }
    match /duels/{id} {
      // 친구 대결: players 에 든 두 사람만 읽고 고친다. 만들 때는 신청한 사람(a)이 자기 uid 로, 상대는 players 에 함께
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn() && request.resource.data.a == request.auth.uid && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players && request.resource.data.state == 'pending';
    }
    match /requests/{toUid}/list/{fromUid} {
      allow read: if mine(toUid) || (signedIn() && request.auth.uid == fromUid);
      allow create: if signedIn() && request.auth.uid == fromUid && fromUid != toUid;
      allow delete: if mine(toUid) || (signedIn() && request.auth.uid == fromUid);
    }
  }
}
