// Firebase 콘솔 → Firestore Database → 규칙 에 그대로 붙여넣는다.
// profiles 는 로그인한 누구나 읽고(친구 찾기) 본인만 쓴다. saves(진행)·friends(친구 목록)는 본인만 읽고 쓴다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if mine(uid) && request.resource.data.name is string && request.resource.data.name.size() <= 8;
      allow delete: if mine(uid);
    }
    match /saves/{uid} {
      allow read, write: if mine(uid) && (!("data" in request.resource.data) || request.resource.data.data.size() < 900000);
    }
    match /friends/{uid}/list/{friendUid} {
      allow read, write: if mine(uid);
    }
  }
}
